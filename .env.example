# Copy to .env for local overrides. Never commit .env. All values below are LOCAL-ONLY defaults.
FDW_PG_HOST=localhost
FDW_PG_PORT=5434
FDW_PG_USER=finance
FDW_PG_PASSWORD=finance_local_only
FDW_S3_ENDPOINT=http://localhost:9100
FDW_S3_ACCESS_KEY=finance_minio
FDW_S3_SECRET_KEY=finance_minio_local_only
FDW_BUCKET=finance-data-lake
# No-Docker fallbacks: FDW_OBJECT_STORE_BACKEND=filesystem and FDW_METADATA_BACKEND=sqlite
# Optional cloud target (dbt --target snowflake). Use key-pair authentication; never store passwords here.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_ROLE=ANALYTICS_ENGINEER
# SNOWFLAKE_WAREHOUSE=FINANCE_TRANSFORM_WH
# SNOWFLAKE_DATABASE=FINANCE_DW
